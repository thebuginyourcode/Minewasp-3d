{
  "appId": "com.thebuginyourcode.minewasp3d",
  "appName": "Minewasp 3D",
  "webDir": "www",
  "backgroundColor": "#000000",
  "android": {
    "backgroundColor": "#000000",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "backgroundColor": "#000000",
    "contentInset": "never",
    "scrollEnabled": false
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    }
  }
}
